---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SiteLayout
  title="Writing"
  description="Writing by Matt Donders: dev notes, app launches, and occasional thoughts."
>
  <section class="writing" aria-labelledby="writing-title">
    <header class="writing-head">
      <span class="eyebrow">Writing</span>
      <h1 id="writing-title">Notes from the workbench.</h1>
      <p>Dev notes, app launch write-ups, and occasional thoughts.</p>
    </header>

    {posts.length === 0 ? (
      <p class="tile empty">No posts yet. Check back soon.</p>
    ) : (
      <ul class="post-list" role="list">
        {posts.map(post => (
          <li class="tile post-row">
            <time class="eyebrow" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <h2><a class="post-link" href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="tag-list" role="list">
                {post.data.tags.map(tag => <li class="tag">{tag}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>
</SiteLayout>

<style>
  .writing { display: flex; flex-direction: column; gap: 40px; }
  .writing-head { display: flex; flex-direction: column; gap: 12px; }
  .writing-head h1 { margin: 0; font-size: clamp(40px, 6vw, 64px); font-weight: 800; letter-spacing: -0.035em; line-height: 1; }
  .writing-head p { margin: 0; font-size: 18px; color: var(--muted); }

  .post-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .post-row { position: relative; display: flex; flex-direction: column; gap: 10px; transition: border-color 0.15s ease; }
  .post-row:has(.post-link:hover) { border-color: var(--subtle); }
  .post-row:has(.post-link:focus-visible) { outline: 2px solid var(--link); outline-offset: 3px; }
  .post-row h2 { margin: 0; font-size: 28px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; }
  .post-row p { margin: 0; font-size: 17px; color: var(--muted); max-width: 760px; }
  .post-row .tag-list { position: relative; z-index: 1; margin-top: 4px; }

  /* The whole tile opens the post. */
  .post-link { color: var(--text); }
  .post-link:hover { color: var(--text); }
  .post-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .post-link:focus-visible { outline: none; }

  .empty { margin: 0; color: var(--muted); }

  @media (max-width: 600px) {
    .post-row h2 { font-size: 22px; }
  }
</style>
