---
// The standard app page. Content lives in src/data/app-pages.ts; name, icon, status and
// App Store link come from src/data/projects.ts.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { appPages, tierPrice, type AppPage } from '../../data/app-pages';
import { projectForSlug, statusLabel, type Project } from '../../data/projects';
import { catalog } from '../../data/catalog';

export function getStaticPaths() {
  return appPages.map(page => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: AppPage;
}

const { page } = Astro.props;
const app = projectForSlug(page.slug, catalog) as Project;

const isExternal = (href: string) => /^https?:\/\//.test(href);
const statusClass = app.status === 'live' ? 'status-live' : app.status === 'review' ? 'status-review' : 'status-soon';
const supportHref = page.support.url ?? `mailto:matt@mattdonders.com?subject=${encodeURIComponent(page.support.subject ?? `${app.name} Support`)}`;
const platforms = app.platforms.map(p => (p === 'iOS' ? 'iPhone' : p)).join(', ');
const priceSummary = page.price
  ?? page.pricing?.tiers.map(t => `${tierPrice(t).price}${t.cadence ? ` ${t.cadence}` : ''}`).join(' · ');

const appleIcon = 'M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z';
const playIcon = 'M3.18 23.76c.3.17.65.19.97.08l11.53-6.66-2.45-2.45-10.05 9.03zM.5 1.12C.18 1.46 0 1.96 0 2.6v18.8c0 .64.18 1.14.51 1.48l.08.07L10.46 12 .58 1.05.5 1.12zM19.37 10.2L16.8 8.7 14.06 11.5l2.75 2.75 2.58-1.49c.74-.42.74-1.12-.02-1.56zM4.15.25L15.67 6.9l-2.45 2.45L3.18.32a1.16 1.16 0 01-.03-.07z';
const storeSoonText = app.status === 'review' ? 'App Store: launching soon' : 'Coming to the App Store';
---

<SiteLayout title={page.title} description={page.description}>
  <a class="back-link" href="/apps">← All apps</a>

  <section class="app-hero" aria-labelledby="app-title">
    <div class="tile hero-main">
      <div class="hero-id">
        {app.icon && <img class="app-icon" src={app.icon} alt="" width="88" height="88" />}
        <div class="hero-id-text">
          <span class="eyebrow">{app.name}</span>
          <span class:list={['status', statusClass]}>{statusLabel[app.status]}</span>
        </div>
      </div>
      <h1 id="app-title">{page.headline}</h1>
      <p class="hero-intro">{page.intro}</p>
      <div class="hero-actions">
        {app.status === 'live' && app.appStore ? (
          <a class="btn btn-primary" href={app.appStore} rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={appleIcon} /></svg>
            Download on the App Store
          </a>
        ) : app.platforms.includes('iOS') && (
          <span class="btn btn-pending">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={appleIcon} /></svg>
            {storeSoonText}
          </span>
        )}
        {page.android?.status === 'live' && page.android.url && (
          <a class="btn btn-outline" href={page.android.url} rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={playIcon} /></svg>
            Get it on Google Play
          </a>
        )}
        {page.android?.status === 'review' && (
          <span class="btn btn-pending">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={playIcon} /></svg>
            Google Play: launching soon
          </span>
        )}
        {page.links?.map(link => (
          <a class="btn btn-outline" href={link.href} rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}>{link.label}</a>
        ))}
      </div>
    </div>

    <dl class="tile hero-facts">
      <div>
        <dt class="eyebrow">Platforms</dt>
        <dd>{platforms}{page.android && !app.platforms.includes('Android') && (page.android.status === 'live' ? ', Android' : ', Android soon')}</dd>
      </div>
      {priceSummary && (
        <div>
          <dt class="eyebrow">Price</dt>
          <dd>{priceSummary}</dd>
        </div>
      )}
      <div>
        <dt class="eyebrow">Help</dt>
        <dd class="fact-links">
          <a href={supportHref} rel={isExternal(supportHref) ? 'noopener' : undefined}>Support</a>
          <a href={page.privacy} rel={isExternal(page.privacy) ? 'noopener' : undefined}>Privacy policy</a>
        </dd>
      </div>
    </dl>
  </section>

  <section class="app-section" aria-labelledby="features-title">
    <h2 id="features-title" class="section-title">{page.features.heading}</h2>
    <ul class="feature-grid" role="list">
      {page.features.items.map((feature, i) => (
        <li class="tile feature">
          <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </li>
      ))}
    </ul>
  </section>

  {page.callout && (
    <section class="tile callout-tile" aria-labelledby="callout-title">
      <span class="eyebrow">{page.callout.eyebrow}</span>
      <h2 id="callout-title">{page.callout.heading}</h2>
      {page.callout.body && <p>{page.callout.body}</p>}
      {page.callout.items && (
        <ul class="callout-items" role="list">
          {page.callout.items.map(item => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  {page.pricing && (
    <section class="app-section" aria-labelledby="pricing-title">
      <div class="section-head">
        <h2 id="pricing-title" class="section-title">{page.pricing.heading}</h2>
        {page.pricing.intro && <p>{page.pricing.intro}</p>}
      </div>
      <ul class="price-grid" role="list">
        {page.pricing.tiers.map(tier => {
          const shown = tierPrice(tier);
          return (
          <li class:list={['tile', 'price-tier', { 'price-highlight': tier.highlight }]}>
            <span class="eyebrow">{tier.name}</span>
            <p class="price">
              <span>{shown.price}</span>
              {shown.was && <s class="price-was"><span class="visually-hidden">Regular price </span>{shown.was}</s>}
              {tier.cadence && <span class="price-cadence">{tier.cadence}</span>}
            </p>
            {shown.note && <span class="price-promo">{shown.note}</span>}
            <ul role="list">
              {tier.items.map(item => <li>{item}</li>)}
            </ul>
          </li>
          );
        })}
      </ul>
      {page.pricing.footnote && <p class="price-footnote">{page.pricing.footnote}</p>}
    </section>
  )}

  <section class="tile support-tile" aria-labelledby="support-title">
    <div>
      <span class="eyebrow">Support</span>
      <h2 id="support-title">Need help with {app.name}?</h2>
      <p>{page.support.note ?? 'Send a note with what you were doing and what you expected to happen. I read every one.'}</p>
    </div>
    <div class="support-actions">
      <a class="btn btn-primary" href={supportHref} rel={isExternal(supportHref) ? 'noopener' : undefined}>
        {page.support.url ? 'Get support' : 'Email support'}
      </a>
      <a class="btn btn-outline" href={page.privacy} rel={isExternal(page.privacy) ? 'noopener' : undefined}>Privacy policy</a>
    </div>
  </section>

  {page.faq && (
    <section class="app-section" aria-labelledby="faq-title">
      <h2 id="faq-title" class="section-title">Common questions</h2>
      <div class="faq-list">
        {page.faq.map(item => (
          <details class="tile faq-item">
            <summary>{item.q}</summary>
            <p set:html={item.a} />
          </details>
        ))}
      </div>
    </section>
  )}

  {page.credits && <p class="credits" set:html={page.credits} />}
</SiteLayout>

<style>
  .back-link { margin-bottom: -64px; }

  .app-hero {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
  }

  .hero-main {
    grid-column: span 4;
    padding: 44px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero-id { display: flex; align-items: center; gap: 20px; }
  .hero-id .app-icon { width: 88px; height: 88px; }
  .hero-id-text { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .hero-main h1 { margin: 0; font-size: clamp(40px, 5vw, 64px); line-height: 1; font-weight: 800; letter-spacing: -0.035em; max-width: 16ch; }
  .hero-intro { margin: 0; font-size: 18px; color: var(--muted); max-width: 600px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .hero-facts {
    grid-column: span 2;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero-facts div { display: flex; flex-direction: column; gap: 6px; }
  .hero-facts dd { margin: 0; font-size: 18px; font-weight: 600; }
  .fact-links { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .fact-links a { font-weight: 600; }

  .app-section { display: flex; flex-direction: column; gap: 32px; }
  .section-head { display: flex; flex-direction: column; gap: 12px; }
  .section-head p { margin: 0; font-size: 18px; color: var(--muted); max-width: 640px; }
  .section-title { margin: 0; font-size: 56px; font-weight: 800; letter-spacing: -0.035em; line-height: 1; }

  .feature-grid, .price-grid, .price-tier ul { list-style: none; margin: 0; padding: 0; }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .feature { display: flex; flex-direction: column; gap: 10px; }
  .feature h3 { margin: 12px 0 0; font-size: 22px; font-weight: 600; line-height: 1.25; }
  .feature p { margin: 0; font-size: 16px; line-height: 1.5; color: var(--muted); }

  .callout-tile {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--on-lime);
    padding: 44px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .callout-tile .eyebrow { color: var(--on-lime); }
  .callout-tile h2 { margin: 0; font-size: 40px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; max-width: 22ch; }
  .callout-tile p { margin: 0; font-size: 18px; line-height: 1.5; max-width: 640px; }

  .callout-items { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .callout-items h3 { margin: 0 0 6px; font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
  .callout-items p { font-size: 16px; }

  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { padding: 0; border-radius: var(--radius-row); }
  .faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 22px 64px 22px 28px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.35;
    position: relative;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--subtle);
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item summary:focus-visible { outline-offset: -2px; border-radius: inherit; }
  .faq-item p { margin: 0; padding: 0 28px 24px; font-size: 16px; line-height: 1.6; color: var(--muted); max-width: 760px; }
  .faq-item p :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .faq-item p :global(strong) { color: var(--text); font-weight: 600; }

  .credits { margin: 0; font-size: 14px; line-height: 1.6; color: var(--subtle); max-width: 820px; }
  .credits :global(a) { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }

  .price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .price-tier { display: flex; flex-direction: column; gap: 16px; }
  .price-highlight { border: 2px solid var(--lime); }
  .price { margin: 0; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .price > span:first-child { font-size: 48px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .price-cadence { font-size: 15px; color: var(--muted); }
  .price-was { font-size: 22px; font-weight: 600; color: var(--subtle); }
  .price-promo { align-self: flex-start; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; padding: 6px 12px; border-radius: 999px; background: var(--lime); color: var(--on-lime); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .price-tier ul { display: flex; flex-direction: column; gap: 8px; }
  .price-tier li { font-size: 16px; color: var(--muted); padding-left: 22px; position: relative; }
  .price-tier li::before { content: '✓'; position: absolute; left: 0; color: var(--text); font-weight: 600; }
  .price-footnote { margin: 0; font-size: 14px; color: var(--subtle); }

  .support-tile {
    padding: 44px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
  }
  .support-tile > div:first-child { display: flex; flex-direction: column; gap: 12px; max-width: 620px; }
  .support-tile h2 { margin: 0; font-size: 40px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .support-tile p { margin: 0; font-size: 17px; color: var(--muted); }
  .support-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 1100px) {
    .hero-main { grid-column: 1 / -1; }
    .hero-facts { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; gap: 20px 48px; }
    .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .callout-items { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }

  @media (max-width: 900px) {
    .back-link { margin-bottom: -40px; }
  }

  @media (max-width: 600px) {
    .back-link { margin-bottom: -32px; }
    .app-hero { gap: 16px; }
    .hero-main, .callout-tile, .support-tile { padding: 28px 24px; }
    .hero-id .app-icon { width: 72px; height: 72px; }
    .hero-intro { font-size: 17px; }
    .hero-actions .btn { width: 100%; }
    .hero-facts { flex-direction: column; }
    .section-title { font-size: 40px; }
    .feature-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .callout-tile h2, .support-tile h2 { font-size: 30px; }
    .support-actions, .support-actions .btn { width: 100%; }
    .faq-item summary { padding: 18px 52px 18px 20px; font-size: 17px; }
    .faq-item summary::after { right: 20px; }
    .faq-item p { padding: 0 20px 20px; }
  }
</style>
