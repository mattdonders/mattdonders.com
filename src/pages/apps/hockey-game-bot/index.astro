---
// Hockey Game Bot is a service, not an app, so it has its own page rather than an
// app-pages.ts entry. Same Home Screen tiles as the app pages.
import SiteLayout from '../../../layouts/SiteLayout.astro';

const coverage = [
  { title: 'Goals', body: 'Instant goal alerts with scorer, assists, time, period, and updated score. Animated goal GIFs generated and attached automatically.' },
  { title: 'Penalties', body: 'Every penalty posted with player, infraction type, duration, and team. Power play and shorthanded situations tracked in real time.' },
  { title: 'Period Updates', body: 'End-of-period summaries with shots, score, and key stats. Overtime and shootout coverage included.' },
  { title: 'Pre-game & Recaps', body: 'Pre-game lineups and matchup cards before puck drop. Final score recaps with stats posted when the game ends.' },
  { title: 'Animated GIFs', body: 'Goal GIFs generated with FFmpeg and posted alongside every goal alert. Visual scoring summaries that stand out in any feed.' },
  { title: 'Milestones', body: 'Notable milestones flagged automatically — hat tricks, shutouts, career goals, and other significant moments.' },
];

const platformGroups = [
  {
    label: 'Real-time during games',
    body: 'Goals, penalties, period updates, and GIFs posted live as they happen.',
    platforms: ['X / Twitter', 'Bluesky', 'Discord'],
    live: true,
  },
  {
    label: 'Recap videos, linked from X & Bluesky',
    body: 'Game recap videos posted after each game, with links shared back to the live feeds.',
    platforms: ['YouTube', 'TikTok', 'Instagram'],
    live: false,
  },
];

const steps = [
  { title: 'Poll the NHL API', body: 'The Python bot polls the NHL Stats API every 5 seconds during live games, detecting new play-by-play events as they happen.' },
  { title: 'Generate assets', body: 'For goal events, animated GIFs are generated with FFmpeg and uploaded to Backblaze B2 storage for attachment to posts.' },
  { title: 'Publish in real time', body: 'Goal and penalty posts go out simultaneously to X, Bluesky, and Discord via their respective APIs. Recap videos are posted separately to YouTube, TikTok, and Instagram, then linked from the live feeds.' },
  { title: 'Feed the apps', body: 'Events are also published to a Cloudflare Workers API backed by D1, powering companion iOS and Android apps with live push notifications.' },
];

const stack = [
  { layer: 'Bot', tech: 'Python 3.11 on DigitalOcean' },
  { layer: 'API', tech: 'Cloudflare Workers + D1' },
  { layer: 'Media', tech: 'FFmpeg + Backblaze B2' },
  { layer: 'Push', tech: 'Firebase Cloud Messaging' },
  { layer: 'iOS', tech: 'SwiftUI + Combine' },
  { layer: 'Android', tech: 'Kotlin + Jetpack Compose' },
];

const follow = [
  { href: 'https://hockeygamebot.com', hero: 'Visit hockeygamebot.com', cta: 'hockeygamebot.com' },
  { href: 'https://bsky.app/profile/hockeygamebot.bsky.social', hero: 'Follow on Bluesky', cta: 'Bluesky' },
  { href: 'https://x.com/hockey_gamebot', hero: 'Follow on X', cta: 'X / Twitter' },
];

const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<SiteLayout
  title="Hockey Game Bot"
  description="Real-time NHL game updates on X and Bluesky during every live game — goals, penalties, animated GIFs — plus recap videos posted to YouTube, TikTok, and Instagram."
>
  <a class="back-link" href="/apps">← All apps</a>

  <section class="hgb-hero" aria-labelledby="hgb-title">
    <div class="tile hero-main">
      <div class="hero-id">
        <img class="app-icon" src="/apps/icons/hgb.png" alt="" width="88" height="88" />
        <div class="hero-id-text">
          <span class="eyebrow">Hockey Game Bot</span>
          <span class="status status-live">Live</span>
        </div>
      </div>
      <h1 id="hgb-title">Live on X &amp; Bluesky. Recaps everywhere else.</h1>
      <p class="hero-intro">
        A production bot that monitors every live NHL game and posts goals, penalties,
        and animated GIFs to X and Bluesky in real time — then publishes recap videos
        to YouTube, TikTok, and Instagram, linked back from both feeds.
      </p>
      <div class="hero-actions">
        {follow.map((link, i) => (
          <a class:list={['btn', i === 0 ? 'btn-primary' : 'btn-outline']} href={link.href} rel="noopener noreferrer">{link.hero}</a>
        ))}
      </div>
    </div>

    <dl class="tile hero-facts">
      <div>
        <dt class="eyebrow">Covers</dt>
        <dd>Every NHL game</dd>
      </div>
      <div>
        <dt class="eyebrow">Live on</dt>
        <dd>X, Bluesky, Discord</dd>
      </div>
      <div>
        <dt class="eyebrow">Recaps on</dt>
        <dd>YouTube, TikTok, Instagram</dd>
      </div>
    </dl>
  </section>

  <section class="hgb-section" aria-labelledby="coverage-title">
    <div class="section-head">
      <h2 id="coverage-title" class="section-title">Every moment, every game</h2>
      <p>The bot watches every NHL game simultaneously and posts automatically — no manual intervention required.</p>
    </div>
    <ul class="grid grid-3" role="list">
      {coverage.map((item, i) => (
        <li class="tile card">
          <span class="eyebrow">{pad(i)}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="hgb-section" aria-labelledby="platforms-title">
    <div class="section-head">
      <h2 id="platforms-title" class="section-title">Two types of coverage</h2>
      <p>Real-time updates during the game, recap videos after — all automated.</p>
    </div>
    <ul class="grid grid-2" role="list">
      {platformGroups.map(group => (
        <li class="tile card">
          <h3>{group.label}</h3>
          <p>{group.body}</p>
          <ul class="tag-list" role="list">
            {group.platforms.map(name => <li class:list={['tag', { 'tag-live': group.live }]}>{name}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section class="hgb-section" aria-labelledby="how-title">
    <h2 id="how-title" class="section-title">Built to run unattended</h2>
    <ol class="grid grid-2" role="list">
      {steps.map((step, i) => (
        <li class="tile card">
          <span class="eyebrow">{pad(i)}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="hgb-section" aria-labelledby="stack-title">
    <h2 id="stack-title" class="section-title">What's under the hood</h2>
    <dl class="grid grid-3 stack">
      {stack.map(item => (
        <div class="tile stack-item">
          <dt class="eyebrow">{item.layer}</dt>
          <dd>{item.tech}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="tile follow-tile" aria-labelledby="follow-title">
    <div>
      <h2 id="follow-title">Follow the bot</h2>
      <p>Pick your platform — updates are posted to all of them.</p>
    </div>
    <div class="follow-actions">
      {follow.map((link, i) => (
        <a class:list={['btn', i === 0 ? 'btn-follow' : 'btn-follow-outline']} href={link.href} rel="noopener noreferrer">{link.cta}</a>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .back-link { margin-bottom: -64px; }

  .hgb-hero { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 20px; }
  .hero-main { grid-column: span 4; padding: 44px; display: flex; flex-direction: column; gap: 24px; }
  .hero-id { display: flex; align-items: center; gap: 20px; }
  .hero-id .app-icon { width: 88px; height: 88px; }
  .hero-id-text { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .hero-main h1 { margin: 0; font-size: clamp(40px, 5vw, 64px); line-height: 1; font-weight: 800; letter-spacing: -0.035em; max-width: 16ch; }
  .hero-intro { margin: 0; font-size: 18px; color: var(--muted); max-width: 600px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .hero-facts { grid-column: span 2; margin: 0; display: flex; flex-direction: column; gap: 28px; }
  .hero-facts div { display: flex; flex-direction: column; gap: 6px; }
  .hero-facts dd { margin: 0; font-size: 18px; font-weight: 600; }

  .hgb-section { display: flex; flex-direction: column; gap: 32px; }
  .section-head { display: flex; flex-direction: column; gap: 12px; }
  .section-head p { margin: 0; font-size: 18px; color: var(--muted); max-width: 640px; }
  .section-title { margin: 0; font-size: 56px; font-weight: 800; letter-spacing: -0.035em; line-height: 1; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .card { display: flex; flex-direction: column; gap: 10px; }
  .card h3 { margin: 0; font-size: 22px; font-weight: 600; line-height: 1.25; }
  .card .eyebrow + h3 { margin-top: 12px; }
  .card p { margin: 0; font-size: 16px; line-height: 1.5; color: var(--muted); }
  .card .tag-list { margin-top: 8px; }
  .tag-live { background: var(--lime); border-color: var(--lime); color: var(--on-lime); }

  .stack-item { display: flex; flex-direction: column; gap: 6px; padding: 24px 28px; }
  .stack-item dd { margin: 0; font-size: 18px; font-weight: 600; }

  .follow-tile {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--on-lime);
    padding: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
  }
  .follow-tile h2 { margin: 0 0 8px; font-size: 40px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .follow-tile p { margin: 0; font-size: 18px; }
  .follow-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn-follow, .btn-follow:hover { background: var(--on-lime); color: var(--lime); }
  .btn-follow:hover { opacity: 0.88; }
  .btn-follow-outline { background: transparent; color: var(--on-lime); border-color: var(--on-lime); }
  .btn-follow-outline:hover { color: var(--on-lime); opacity: 0.75; }
  .follow-tile :focus-visible { outline-color: var(--on-lime); }

  @media (max-width: 1100px) {
    .hero-main { grid-column: 1 / -1; }
    .hero-facts { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; gap: 20px 48px; }
    .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .back-link { margin-bottom: -40px; }
  }

  @media (max-width: 600px) {
    .back-link { margin-bottom: -32px; }
    .hgb-hero { gap: 16px; }
    .hero-main, .follow-tile { padding: 28px 24px; }
    .hero-id .app-icon { width: 72px; height: 72px; }
    .hero-intro { font-size: 17px; }
    .hero-actions .btn, .follow-actions, .follow-actions .btn { width: 100%; }
    .hero-facts { flex-direction: column; }
    .section-title { font-size: 40px; }
    .grid-3, .grid-2 { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .follow-tile h2 { font-size: 30px; }
  }
</style>
