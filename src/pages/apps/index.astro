---
import SiteLayout from '../../layouts/SiteLayout.astro';
import AppList from '../../components/AppList.astro';
import { appGroup, inWords, listedApps, listedServices } from '../../data/projects';
import { catalog } from '../../data/catalog';

const apps = listedApps(catalog);
const services = listedServices(catalog);
const live = apps.filter(p => p.status === 'live');
const inReview = apps.filter(p => p.status === 'review');
const soon = apps.filter(p => appGroup(p.status) === 'soon');
const onTheWay = soon.length - inReview.length;

const capitalized = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const summaryParts = [
  `${capitalized(inWords(live.length))} on the App Store`,
  inReview.length > 0 && `${inWords(inReview.length)} launching soon`,
  onTheWay > 0 && `${inWords(onTheWay)} on the way`,
].filter(Boolean) as string[];
const summary = summaryParts.length > 1
  ? `${summaryParts.slice(0, -1).join(', ')}, and ${summaryParts.at(-1)}.`
  : `${summaryParts[0]}.`;

---

<SiteLayout
  title="Apps"
  description={`Every app Matt Donders has built. ${summary}`}
>
  <section class="intro" aria-labelledby="apps-title">
    <div class="tile intro-hero">
      <span class="eyebrow">Apps</span>
      <h1 id="apps-title">Small apps for <span class="accent">ordinary jobs.</span></h1>
      <p>{summary} Built in Swift, Kotlin, and Cloudflare Workers.</p>
    </div>

    <div class="tile intro-stat">
      <span class="eyebrow">On the App Store</span>
      <div class="stat-row">
        <span class="stat-number">{live.length}</span>
        <span class="stat-label">live apps</span>
      </div>
    </div>

    {inReview.length > 0 && (
      <div class="tile intro-stat">
        <span class="eyebrow">Launching soon</span>
        <div class="review-icons">
          {inReview.map(p => p.icon && (
            <img class="app-icon" src={p.icon} alt={p.name} width="56" height="56" />
          ))}
        </div>
      </div>
    )}
  </section>

  <AppList />

  {services.length > 0 && (
    <section class="catalog" aria-labelledby="behind-the-apps">
      <div class="catalog-head">
        <h2 id="behind-the-apps">Behind the apps</h2>
      </div>
      <ul class="app-list" role="list">
        {services.map(service => (
          <li class="app-row service-row">
            {service.icon && <img class="app-icon" src={service.icon} alt="" width="64" height="64" loading="lazy" />}
            <div class="app-text">
              <h3>{service.url ? <a class="app-link" href={service.url}>{service.name}</a> : service.name}</h3>
              <p class="service-tagline">{service.tagline}</p>
              <p>{service.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</SiteLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(200px, auto);
    gap: 20px;
  }

  .intro-hero {
    grid-column: span 4;
    grid-row: span 2;
    padding: 44px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }

  .intro-hero h1 {
    margin: 0;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .intro-hero p { margin: 0; font-size: 18px; color: var(--muted); max-width: 540px; }

  .intro-stat {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .stat-row { display: flex; align-items: baseline; gap: 12px; }
  .stat-number { font-size: 64px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .stat-label { font-size: 15px; color: var(--muted); }

  .review-icons { display: flex; gap: 12px; flex-wrap: wrap; }
  .review-icons .app-icon { width: 56px; height: 56px; }

  @media (max-width: 1100px) {
    .intro-hero { grid-column: 1 / -1; grid-row: auto; }
    .intro-stat { grid-column: span 3; }
  }

  @media (max-width: 600px) {
    .intro { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; gap: 16px; }
    .intro-hero, .intro-stat { grid-column: 1 / -1; }
    .intro-hero { padding: 28px 24px; }
    .intro-hero p { font-size: 17px; }
    .stat-number { font-size: 52px; }
  }
  .service-row { grid-column: 1 / -1; align-items: flex-start; }
  .service-row .app-text { max-width: 760px; }
  .service-tagline { color: var(--text) !important; font-weight: 600; }
</style>
