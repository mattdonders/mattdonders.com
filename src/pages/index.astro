---
import SiteLayout from '../layouts/SiteLayout.astro';
import AppList from '../components/AppList.astro';
import { appGroup, inWords, listedApps, spotlightApp } from '../data/projects';
import { getCollection } from 'astro:content';

const apps = listedApps();
const live = apps.filter(p => p.status === 'live');
const inReview = apps.filter(p => p.status === 'review');
const building = apps.filter(p => p.status === 'development' || p.status === 'beta');
const soonCount = apps.filter(p => appGroup(p.status) === 'soon').length;
const spotlight = spotlightApp();
const reviewTile = inReview.filter(p => p !== spotlight);

const capitalized = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const subline = [
  'Swift, Kotlin, and Cloudflare Workers.',
  `${capitalized(inWords(live.length))} apps on the App Store so far${inReview.length > 0 ? `, and ${inWords(inReview.length)} more in review.` : '.'}`,
].join(' ');

const posts = await getCollection('blog', ({ data }) => !data.draft);
const latestPost = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const isExternal = (url?: string) => !!url && /^https?:\/\//.test(url);
---

<SiteLayout
  title="Matt Donders"
  description={`Matt Donders makes small iPhone and Android apps. ${subline}`}
>
  <section class="bento" aria-labelledby="home-title">
    <div class="tile hero">
      <span class="eyebrow">Hi, I'm Matt</span>
      <h1 id="home-title">I make apps you'd actually keep on your <span class="accent">home screen.</span></h1>
      <p>{subline}</p>
    </div>

    <ul class="icon-grid" role="list" aria-label="Apps on the App Store">
      {live.slice(0, 6).map(app => (
        <li>
          <a class="tile icon-tile" href={app.url}>
            {app.icon && <img class="app-icon" src={app.icon} alt="" width="96" height="96" />}
            <span>{app.name}</span>
          </a>
        </li>
      ))}
    </ul>

    {spotlight && (
      <div class="tile spotlight">
        <span class="eyebrow spotlight-eyebrow">
          <span class="spotlight-dot" aria-hidden="true"></span>Next up · {spotlight.status === 'review' ? 'In App Review' : 'Coming soon'}
        </span>
        <div class="spotlight-body">
          {spotlight.icon && <img class="app-icon" src={spotlight.icon} alt="" width="72" height="72" />}
          <h2>{spotlight.name}</h2>
          <p>{spotlight.spotlight}</p>
        </div>
        {spotlight.url && (
          <a class="spotlight-link" href={spotlight.url} rel={isExternal(spotlight.url) ? 'noopener' : undefined}>
            {spotlight.url.replace(/^https?:\/\//, '')} →
          </a>
        )}
      </div>
    )}

    {building.length > 0 && (
      <div class="tile small-tile">
        <span class="eyebrow">Now building</span>
        {building.map(app => (
          <div class="mini-app">
            {app.icon && <img class="app-icon" src={app.icon} alt="" width="56" height="56" />}
            <div>
              <a class="mini-name" href={app.url}>{app.name}</a>
              <span class="mini-tagline">{app.tagline}</span>
            </div>
          </div>
        ))}
      </div>
    )}

    {reviewTile.length > 0 && (
      <div class="tile small-tile">
        <span class="eyebrow">In App Review</span>
        <div class="review-row">
          {reviewTile.map(app => app.icon && (
            <a href={app.url}><img class="app-icon" src={app.icon} alt={app.name} width="56" height="56" /></a>
          ))}
          <span class="mini-tagline">{reviewTile.map(p => p.name).join(', ')}</span>
        </div>
      </div>
    )}

    {latestPost && (
      <div class="tile small-tile">
        <span class="eyebrow">Latest note</span>
        <a class="note-link" href={`/blog/${latestPost.slug}`}>{latestPost.data.title} →</a>
      </div>
    )}

    <div class="tile small-tile">
      <span class="eyebrow">Shipped</span>
      <div class="shipped">
        <span class="shipped-number">{live.length}</span>
        <span class="mini-tagline">live on the App Store{soonCount > 0 && ` · ${soonCount} on the way`}</span>
      </div>
    </div>
  </section>

  <nav class="dock" aria-label="Elsewhere">
    <a href="https://github.com/mattdonders" aria-label="GitHub" rel="noopener noreferrer">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
    </a>
    <a href="https://twitter.com/mattdonders" aria-label="X" rel="noopener noreferrer">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20"></path></svg>
    </a>
    <a href="mailto:matt@mattdonders.com" aria-label="Email">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
    </a>
    <a href="/rss.xml" aria-label="RSS" class="dock-rss">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
    </a>
  </nav>

  <AppList />
</SiteLayout>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: 200px;
    gap: 20px;
  }

  .hero {
    grid-column: span 3;
    grid-row: span 2;
    padding: 44px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }
  .hero h1 { margin: 0; font-size: 56px; line-height: 1; font-weight: 800; letter-spacing: -0.035em; }
  .hero p { margin: 0; font-size: 18px; color: var(--muted); max-width: 540px; }

  /* The six icon tiles fill the 3x2 block beside the hero. */
  .icon-grid {
    grid-column: span 3;
    grid-row: span 2;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .icon-tile {
    height: 100%;
    padding: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    transition: border-color 0.15s ease;
  }
  .icon-tile:hover { color: var(--text); border-color: var(--subtle); }
  .icon-tile .app-icon { width: 96px; height: 96px; }

  .spotlight {
    grid-column: span 2;
    grid-row: span 2;
    background: var(--lime);
    border-color: var(--lime);
    color: var(--on-lime);
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }
  .spotlight-eyebrow { color: var(--on-lime); display: flex; align-items: center; gap: 10px; }
  .spotlight-dot { width: 10px; height: 10px; border-radius: 999px; background: var(--on-lime); }
  .spotlight-body { display: flex; flex-direction: column; gap: 10px; }
  .spotlight-body .app-icon { width: 72px; height: 72px; box-shadow: none; margin-bottom: 4px; }
  .spotlight h2 { margin: 0; font-size: 40px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .spotlight p { margin: 0; font-size: 16px; line-height: 1.45; }
  .spotlight-link { color: var(--on-lime); font-weight: 600; font-size: 16px; }
  .spotlight-link:hover { color: var(--on-lime); text-decoration: underline; }
  .spotlight :focus-visible { outline-color: var(--on-lime); }

  .small-tile {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }

  .mini-app { display: flex; align-items: center; gap: 16px; }
  .mini-app > div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mini-app .app-icon, .review-row .app-icon { width: 56px; height: 56px; }
  .mini-name { color: var(--text); font-size: 20px; font-weight: 600; }
  .mini-name:hover { color: var(--text); text-decoration: underline; }
  .mini-tagline { font-size: 15px; line-height: 1.4; color: var(--muted); }

  .review-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .review-row .mini-tagline { margin-left: 4px; }

  .note-link { color: var(--text); font-size: 20px; font-weight: 600; line-height: 1.25; }
  .note-link:hover { color: var(--text); text-decoration: underline; }

  .shipped { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .shipped-number { font-size: 64px; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }

  .dock {
    align-self: center;
    display: flex;
    gap: 14px;
    padding: 14px;
    border-radius: 32px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .dock a {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--text);
    color: var(--bg);
    transition: transform 0.15s ease;
  }
  .dock a:hover { color: var(--bg); transform: translateY(-3px); }
  .dock a.dock-rss, .dock a.dock-rss:hover { background: var(--lime); color: var(--on-lime); }

  @media (prefers-reduced-motion: reduce) {
    .dock a { transition: none; }
    .dock a:hover { transform: none; }
  }

  @media (max-width: 1100px) {
    .bento { grid-auto-rows: minmax(180px, auto); }
    .hero { grid-column: 1 / -1; grid-row: auto; }
    .icon-grid { grid-column: 1 / -1; grid-row: auto; grid-template-rows: none; }
    .icon-tile { aspect-ratio: 16 / 9; }
    .spotlight { grid-column: 1 / -1; grid-row: auto; }
    .small-tile { grid-column: span 3; }
  }

  @media (max-width: 600px) {
    .bento { grid-auto-rows: auto; gap: 16px; }
    .hero { padding: 28px 24px; }
    .hero h1 { font-size: 42px; }
    .hero p { font-size: 17px; }
    .icon-grid { gap: 12px; }
    .icon-tile { aspect-ratio: 1; padding: 12px 8px; font-size: 13px; gap: 8px; }
    .icon-tile .app-icon { width: 64px; height: 64px; }
    .spotlight { padding: 28px 24px; }
    .spotlight h2 { font-size: 34px; }
    .small-tile { grid-column: 1 / -1; min-height: 150px; }
    .dock { gap: 10px; padding: 10px; border-radius: 26px; }
    .dock a { width: 56px; height: 56px; border-radius: 14px; }
  }
</style>
