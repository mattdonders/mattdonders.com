---
import DocLayout from './DocLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const meta = updatedDate
  ? `${formatDate(pubDate)} · Updated ${formatDate(updatedDate)}`
  : formatDate(pubDate);
---

<DocLayout
  title={title}
  description={description}
  ogType="article"
  heading={title}
  lede={description}
  meta={meta}
  tags={tags}
  back={{ href: '/blog', label: 'All writing' }}
>
  <slot />
</DocLayout>
